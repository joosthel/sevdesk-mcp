# sevdesk-mcp — local development configuration.
#
# Copy to `.env` and fill in your token. Used only for runs outside an MCP
# client (`npm run dev`, `node dist/index.js`). When your MCP client passes
# these through its own `env` block, that block wins over this file.
#
# `.env` is gitignored. Your sevDesk token has no scopes — it can do
# everything your login can — so treat it like a password.

# Required. sevDesk: Settings -> Users -> your user -> API (32-char hex).
SEVDESK_API_TOKEN=

# Strongly recommended while developing: hide the write tools entirely.
SEVDESK_READ_ONLY=true

# Show what a write *would* send, without sending it.
# SEVDESK_DRY_RUN=false

# List the booking tools (link vouchers to bank transactions, remove payments).
# They book and remove payments on open vouchers. Off unless set.
# sevdesk_call is not covered by this flag.
# SEVDESK_ALLOW_BOOKING=false

# Allowlist of absolute directories the receipt file tools may touch, separated
# by ":" (macOS/Linux) or ";" (Windows).
# Unset means the file tools stay disabled.
# SEVDESK_RECEIPT_DIRS=/Users/you/Belege:/Users/you/Downloads

# Must be https:// (http:// only for localhost/127.0.0.1/[::1]).
# SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1
# SEVDESK_TIMEOUT_MS=30000
# SEVDESK_MAX_RETRIES=3
# SEVDESK_RATE_LIMIT=4

# Log `METHOD /path -> status` to stderr. Never logs the token or bodies.
# SEVDESK_DEBUG=false
